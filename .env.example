# Copy to .env (which is git-ignored). Never commit real secrets.

# --- data layout ---
PATHSNAP_DATA_ROOT=./data
PATHSNAP_EVALUATION_PARTITION=evaluator_test
PATHSNAP_FALLBACK_PARTITION=student_test

# --- artifacts ---
PATHSNAP_ARTIFACT_DIR=./artifacts

# --- API / UI ---
PATHSNAP_API_URL=http://localhost:8000
PATHSNAP_CORS_ORIGINS=*
# Optional. If set on Laptop 1, the UI must send X-API-Key.
PATHSNAP_API_KEY=

# --- reproducibility ---
PATHSNAP_SEED=42
